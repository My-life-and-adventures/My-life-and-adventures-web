# API base URL.
# Local dev (with Vite proxy): /api/v1
# Vercel / production: your deployed backend, e.g. https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=/api/v1

# Vite dev proxy target (local only). Defaults to http://localhost:3000
# VITE_DEV_API_PROXY=http://192.168.18.2:3000

# ─── Admin dashboard (/admin) ────────────────────────────────────────────────
# Admins sign in with a Supabase magic link. Same project the backend verifies
# tokens for, and the same anon key the mobile app uses — it is public by design.
# Who counts as an admin is decided by ADMIN_EMAILS on the BACKEND, never here.
# Leave unset and /admin will say so rather than half-working.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Canonical origin for magic-link sign-in, no trailing slash. Defaults to
# whatever origin the page is served from, which is wrong on Vercel preview
# deploys (random hostname per deploy, so it can never be allowlisted).
# Whatever this resolves to must ALSO be listed in the Supabase dashboard under
# Authentication -> URL Configuration -> Redirect URLs. An address that is not
# on that list is not rejected: Supabase quietly substitutes the project's
# Site URL instead, and the link arrives pointing somewhere unrelated.
VITE_PUBLIC_SITE_URL=https://www.mylife-and-adventures.com
